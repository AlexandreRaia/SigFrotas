# Copie para .env e preencha. Nunca versionar o .env.

# Django
DJANGO_SECRET_KEY=trocar-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Se preenchido, o login nao pede a prefeitura (implantacao de uma prefeitura so)
MUNICIPIO_PADRAO_SLUG=

# PostgreSQL
DB_NAME=sigfrotas
DB_HOST=localhost
DB_PORT=5432

# Superusuario do Postgres (so para criar banco e roles e para o backup; a aplicacao nao usa)
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=

# Role dona das tabelas (usada nas migracoes)
DB_OWNER_USER=sigfrotas_owner
DB_OWNER_PASSWORD=

# Role da aplicacao (sem BYPASSRLS, nao e dona das tabelas)
DB_APP_USER=sigfrotas_app
DB_APP_PASSWORD=

# --- So na VPS (docker compose) ---
# Dominio do sistema (HTTPS automatico). Em producao vira o unico host permitido.
DOMINIO=frotas.exemplo.gov.br
# Frase que criptografa os backups. GUARDE-A FORA DO SERVIDOR: sem ela o backup nao abre.
BACKUP_PASSPHRASE=
# Dias de guarda dos backups no servidor
RETENCAO_DIAS=14

# --- E-mail das notificacoes (producao) ---
# Em desenvolvimento os e-mails aparecem no terminal (nao precisa preencher).
# Em producao: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend e os dados do servico de e-mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=sigfrotas@exemplo.gov.br
# Endereco do sistema (vira o link nos e-mails)
SITE_URL=https://frotas.exemplo.gov.br
